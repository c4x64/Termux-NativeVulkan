<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen distro GUI first: Vulkan surface fills the screen from launch,
     status floats on top, terminal is a bottom overlay toggled by TERM. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root">

    <!-- Distro GUI surface: fullscreen from start -->
    <dev.tnvk.app.TnvkView
        android:id="@+id/gui_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <View
            android:id="@+id/status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_idle"
            android:contentDescription="GUI status indicator" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZERO TWO // TNVK"
                style="@style/Tnvk.HeaderTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="distro gui :: vulkan surface"
                style="@style/Tnvk.HeaderSubtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHECKING"
            style="@style/Tnvk.StatusPill" />
    </LinearLayout>

    <!-- Terminal overlay: hidden until TERM toggles it -->
    <dev.tnvk.app.TermView
        android:id="@+id/term_view"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!-- Terminal toggle -->
    <Button
        android:id="@+id/term_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_margin="12dp"
        android:text="TERM"
        style="@style/Tnvk.SendButton" />

</FrameLayout>
